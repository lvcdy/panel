---
import { createDefaultPanelConfig } from '../lib/panel/defaults';
import { renderNavigationHtml } from '../lib/panel/render';

const defaultNavigationHtml = renderNavigationHtml(createDefaultPanelConfig());
---

<nav
  id="linkGrid"
  class="w-full max-w-[1500px] px-4 sm:px-10 mt-8 flex-grow"
  aria-label="链接导航"
  data-link-grid
>
  <div id="linkGridPlaceholder" class="link-grid-placeholder" aria-hidden="true">
    正在载入配置…
  </div>
  <div id="linkGridContent" set:html={defaultNavigationHtml}></div>
  <div
    id="searchEmptyState"
    class="search-empty-state hidden"
    role="status"
    aria-live="polite"
  >
    <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
    <p id="searchEmptyTitle">没有找到匹配的网站</p>
    <p id="searchEmptyHint">
      试试搜索网站名称、URL、描述、标签或分类名，或按回车使用搜索引擎。
    </p>
    <button
      id="searchEmptyClear"
      type="button"
      class="search-empty-clear"
    >
      清除搜索
    </button>
  </div>
</nav>
