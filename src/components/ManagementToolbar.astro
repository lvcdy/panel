<div
  id="panel-edit-toolbar"
  class="panel-edit-toolbar hidden"
  role="region"
  aria-label="导航编辑工具栏"
  aria-hidden="true"
>
  <span class="panel-edit-label">
    <i class="fas fa-pen" aria-hidden="true"></i>
    <span>编辑模式</span>
  </span>
  <button
    id="panel-add-site-btn"
    type="button"
    class="panel-btn panel-btn-primary"
  >
    <i class="fas fa-plus" aria-hidden="true"></i>
    添加网站
  </button>
  <button
    id="panel-manage-categories-btn"
    type="button"
    class="panel-btn panel-btn-secondary"
  >
    <i class="fas fa-folder-tree" aria-hidden="true"></i>
    管理分类
  </button>
  <button
    id="panel-exit-edit-btn"
    type="button"
    class="panel-btn panel-btn-secondary"
  >
    完成
  </button>
</div>
