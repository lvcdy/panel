---
const profileConfig = { name: "与众不同的糖" };
---

<div
  class="border-t border-white/10 my-5 border-dashed mx-4 sm:mx-10 lg:mx-32 will-reveal"
>
  <div class="animate-fade-in-up"></div>
</div>

<footer
  class="mb-8 flex flex-col items-center justify-center px-4 sm:px-6 py-5 select-none will-reveal"
>
  <div
    class="text-white/60 text-[11px] sm:text-xs text-center leading-relaxed [text-shadow:0_1px_4px_rgba(0,0,0,0.5)] animate-fade-in-up"
  >
    <div class="mb-1">
      &copy; <span id="footerYear"></span>
      <a
        href="https://blog.lvcdy.cn"
        target="_blank"
        rel="noopener noreferrer"
        class="font-bold text-white/80 hover:text-white hover:underline transition-colors"
      >
        {profileConfig.name}
      </a>. All Rights Reserved.
    </div>

    <div class="mb-3 opacity-80">
      Powered by
      <a
        class="text-white hover:underline font-medium"
        target="_blank"
        rel="noopener noreferrer"
        href="https://astro.build"
      >Astro</a>
      &
      <a
        class="text-white hover:underline font-medium"
        target="_blank"
        rel="noopener noreferrer"
        href="https://github.com/lvcdy/panel"
      >Panel</a>
    </div>

    <div class="flex flex-col items-center gap-y-1.5 mb-4 text-white/50">
      <a
        href="https://beian.miit.gov.cn/"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-white transition-all flex items-center gap-1.5"
      >
        <img
          src="https://ywtb.mps.gov.cn/authservice/images/foot-icp.png"
          class="w-3 h-3 brightness-110 opacity-80"
          alt="ICP"
          width="12"
          height="12"
          loading="lazy"
          decoding="async"
        />
        <span>辽 ICP 备 2025051495 号-2</span>
      </a>
      <a
        href="https://beian.mps.gov.cn/#/query/webSearch?code=21070002000117"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-white transition-all flex items-center gap-1.5"
      >
        <img
          src="https://beian.mps.gov.cn/img/logo01.dd7ff50e.png"
          class="w-3 h-3 brightness-110 opacity-80"
          alt="GWA"
          width="12"
          height="12"
          loading="lazy"
          decoding="async"
        />
        <span>辽公网安备 21070002000117 号</span>
      </a>
    </div>

    <div
      id="network-info"
      class="network-info"
      data-state="loading"
      aria-live="polite"
    >
      <span id="network-info-loading" class="network-info-status">
        正在获取网络信息...
      </span>
      <span id="network-info-unavailable" class="network-info-status" hidden>
        网络信息暂不可用
      </span>

      <span class="network-info-item" data-network-item="clientIp" hidden>
        <span class="network-info-label">出口 IP</span>
        <span id="network-ip" class="network-info-value"></span>
      </span>
      <span class="network-info-item" data-network-item="location" hidden>
        <span class="network-info-label">位置</span>
        <span id="network-location" class="network-info-value"></span>
      </span>
      <span class="network-info-item" data-network-item="organization" hidden>
        <span class="network-info-label">网络</span>
        <span id="network-organization" class="network-info-value"></span>
      </span>
      <span class="network-info-item" data-network-item="asn" hidden>
        <span class="network-info-label">ASN</span>
        <span id="network-asn" class="network-info-value"></span>
      </span>
      <span class="network-info-item" data-network-item="edgeLocation" hidden>
        <span class="network-info-label">边缘</span>
        <span id="network-edge" class="network-info-value"></span>
      </span>
      <span class="network-info-item" data-network-item="platform" hidden>
        <span class="network-info-label">平台</span>
        <span id="network-platform" class="network-info-value"></span>
      </span>

      <button
        id="network-info-refresh"
        type="button"
        class="network-info-refresh"
        aria-label="刷新网络信息"
        title="刷新网络信息"
      >
        <i class="fas fa-rotate" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</footer>
