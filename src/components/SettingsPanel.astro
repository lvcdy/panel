---
---

<div class="settings-container">
  <button
    type="button"
    id="settings-toggle"
    class="settings-btn"
    aria-label="打开设置"
    aria-expanded="false"
    aria-controls="settings-panel"
  >
    <i class="fas fa-gear" aria-hidden="true"></i>
  </button>

  <div
    id="settings-panel"
    class="settings-panel"
    role="dialog"
    aria-labelledby="settings-title"
    aria-hidden="true"
  >
    <div class="settings-content">
      <div class="settings-header">
        <h2 id="settings-title" class="settings-title">设置</h2>
        <button
          type="button"
          id="settings-close"
          class="settings-close-btn"
          aria-label="关闭设置"
        >
          <i class="fas fa-times" aria-hidden="true"></i>
        </button>
      </div>

      <div class="settings-body">
        <div class="setting-item">
          <label for="blur-slider" class="setting-label">毛玻璃强弱</label>
          <div class="slider-container">
            <input
              id="blur-slider"
              type="range"
              min="0"
              max="100"
              value="18"
              class="blur-slider"
              aria-label="调节毛玻璃强弱"
            />
            <span id="blur-value" class="blur-value">18px</span>
          </div>
          <div class="slider-description">
            <span>弱</span>
            <span>强</span>
          </div>
        </div>

        <div class="setting-item">
          <label for="saturate-slider" class="setting-label">饱和度</label>
          <div class="slider-container">
            <input
              id="saturate-slider"
              type="range"
              min="100"
              max="200"
              value="165"
              class="saturate-slider"
              aria-label="调节饱和度"
            />
            <span id="saturate-value" class="saturate-value">165%</span>
          </div>
        </div>

        <div class="setting-item">
          <label for="bg-url-input" class="setting-label">
            自定义背景图 URL
          </label>
          <input
            id="bg-url-input"
            type="url"
            class="bg-url-input"
            placeholder="https://example.com/background.jpg"
            aria-label="输入自定义背景图 URL"
          />
          <div class="bg-actions">
            <button id="bg-url-apply" type="button" class="bg-action-btn">
              应用
            </button>
            <button
              id="bg-url-reset"
              type="button"
              class="bg-action-btn bg-action-btn-secondary"
            >
              恢复默认
            </button>
          </div>
        </div>

        <div class="setting-item">
          <label for="hitokoto-api-input" class="setting-label">
            自定义一言 API
          </label>
          <input
            id="hitokoto-api-input"
            type="url"
            class="bg-url-input"
            placeholder="https://example.com/hitokoto"
            aria-label="输入自定义一言 API"
          />
          <div class="bg-actions">
            <button id="hitokoto-api-apply" type="button" class="bg-action-btn">
              应用
            </button>
            <button
              id="hitokoto-api-reset"
              type="button"
              class="bg-action-btn bg-action-btn-secondary"
            >
              恢复默认
            </button>
          </div>
        </div>

        <section class="settings-section" aria-labelledby="settings-edit-nav-title">
          <h3 id="settings-edit-nav-title" class="settings-section-title">
            导航编辑
          </h3>
          <p class="settings-section-hint">
            进入编辑模式后可添加、编辑、删除网站；编辑模式不会被保存，刷新后自动退出。
          </p>
          <button
            id="open-edit-mode-btn"
            type="button"
            class="bg-action-btn settings-data-btn settings-data-btn-primary"
          >
            编辑导航
          </button>
        </section>

        <section class="settings-section" aria-labelledby="settings-backup-title">
          <h3 id="settings-backup-title" class="settings-section-title">
            配置备份
          </h3>
          <p class="settings-section-hint">
            导出或导入 JSON 备份文件。导入前会先校验完整数据。
          </p>
          <div class="settings-action-grid">
            <button
              id="export-all-btn"
              type="button"
              class="bg-action-btn settings-data-btn"
            >
              导出全部配置
            </button>
            <button
              id="export-nav-btn"
              type="button"
              class="bg-action-btn settings-data-btn"
            >
              导出导航配置
            </button>
            <button
              id="import-all-btn"
              type="button"
              class="bg-action-btn settings-data-btn"
            >
              导入全部配置
            </button>
            <button
              id="import-nav-btn"
              type="button"
              class="bg-action-btn settings-data-btn"
            >
              导入导航配置
            </button>
          </div>
          <input
            id="import-all-input"
            type="file"
            accept="application/json,.json"
            class="hidden"
            aria-hidden="true"
            tabindex="-1"
          />
          <input
            id="import-nav-input"
            type="file"
            accept="application/json,.json"
            class="hidden"
            aria-hidden="true"
            tabindex="-1"
          />
        </section>

        <section class="settings-section" aria-labelledby="settings-restore-nav-title">
          <h3 id="settings-restore-nav-title" class="settings-section-title">
            恢复导航
          </h3>
          <p class="settings-section-hint">
            仅恢复默认网站、分类和排序，保留背景、搜索引擎、一言与毛玻璃设置。
          </p>
          <button
            id="restore-nav-btn"
            type="button"
            class="bg-action-btn settings-data-btn settings-data-btn-warning"
          >
            恢复默认导航
          </button>
        </section>

        <section class="settings-section" aria-labelledby="settings-restore-all-title">
          <h3 id="settings-restore-all-title" class="settings-section-title">
            恢复全部设置
          </h3>
          <p class="settings-section-hint">
            清除当前导航与个性化设置，恢复初始状态，无法自动撤销。
          </p>
          <button
            id="restore-all-btn"
            type="button"
            class="bg-action-btn settings-data-btn settings-data-btn-danger"
          >
            恢复全部设置
          </button>
        </section>
      </div>
    </div>
  </div>

  <div id="settings-overlay" class="settings-overlay" aria-hidden="true"></div>
</div>
