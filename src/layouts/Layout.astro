---
interface Props {
  title?: string;
}

const { title = 'Panel' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN" class="scrollbar-hide">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Panel" />
    <meta name="theme-color" content="#0b1220" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Panel" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="Panel" />
    <title>{title}</title>
    <script is:inline>
      try {
        if (window.localStorage.getItem("panel-config")) {
          document.documentElement.setAttribute("data-panel-config-pending", "");
          window.setTimeout(function () {
            document.documentElement.removeAttribute("data-panel-config-pending");
          }, 4000);
        }
      } catch (error) {
        // localStorage 不可用时保持默认内容可见。
      }
    </script>
    <noscript>
      <style>
        /* 无 JS 时 reveal 观察器与配置渲染都不会执行：强制显示全部内容。 */
        .animate-fade-in-up,
        .will-reveal,
        .will-reveal .animate-fade-in-up {
          opacity: 1 !important;
          visibility: visible !important;
          transform: none !important;
          animation: none !important;
        }

        .info-capsule {
          opacity: 1 !important;
          transform: none !important;
        }

        #linkGridContent {
          visibility: visible !important;
        }
      </style>
    </noscript>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://api.lvcdy.cn" crossorigin />
    <link rel="preconnect" href="https://api.afmax.cn" crossorigin />
    <link rel="preconnect" href="https://t.alcy.cc" crossorigin />
    <link rel="preload" as="image" href="https://t.alcy.cc/ycy" fetchpriority="high" />
    <link rel="dns-prefetch" href="https://api.lvcdy.cn" />
    <link rel="dns-prefetch" href="https://api.afmax.cn" />
    <link rel="dns-prefetch" href="https://t.alcy.cc" />
  </head>
  <body class="relative min-h-screen antialiased bg-[#0b1220] overflow-x-hidden selection:bg-white/20">
    <div class="page-aurora" aria-hidden="true"></div>
    <div class="page-vignette" aria-hidden="true"></div>
    <slot />
  </body>
</html>
