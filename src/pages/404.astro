---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
---

<Layout title="页面未找到 - Panel">
  <main class="min-h-screen flex items-center justify-center px-6 relative z-10 text-white">
    <div class="glass rounded-2xl p-8 text-center max-w-md w-full">
      <p class="text-5xl font-bold tracking-tight">404</p>
      <p class="mt-3 text-sm text-white/60">
        你访问的页面不存在，或已经被移动。
      </p>
      <a
        href={base}
        class="inline-flex items-center justify-center mt-6 min-h-9 px-4 rounded-lg border border-white/20 bg-white/10 text-sm font-medium text-white hover:bg-white/18 transition-colors"
      >
        返回首页
      </a>
    </div>
  </main>
</Layout>
