---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SearchBar from '../components/SearchBar.astro';
import LinkGrid from '../components/LinkGrid.astro';
import Footer from '../components/Footer.astro';
import SettingsPanel from '../components/SettingsPanel.astro';
import FloatingButton from '../components/FloatingButton.astro';
import '../styles/global.css';
---

<Layout>
  <main class="flex flex-col items-center min-h-screen relative z-10 text-white">
    <Header />
    <SearchBar />
    <LinkGrid />
    <Footer />
  </main>
  <SettingsPanel />
  <FloatingButton />
  <script>
    import { initApp } from '../main';
    initApp();
  </script>
</Layout>
